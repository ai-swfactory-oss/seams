    "@ai-swfactory-oss/seams-module": { "kind": "sdk" },
    "@ai-swfactory-oss/seams-http-server": { "kind": "sdk" },
    "@ai-swfactory-oss/seams-tool-runner": { "kind": "sdk" },
    "@ai-swfactory-oss/seams-node-runtime": { "kind": "sdk" },
    "@ai-swfactory-oss/seams-retry": { "kind": "sdk" },
    "@ai-swfactory-oss/seams-lint-kit": { "kind": "sdk" },

{
  "version": 4,
  "defaultBranch": "main",
  "guard": {},
  "generators": {
    "terminal-broken-pipe": {
      "kind": "module",
      "module": "packages/terminal/tools/generate-broken-pipe.mjs",
      "inputs": ["packages/terminal/src/**", "packages/terminal/tools/**"],
      "outputs": ["packages/terminal/tests/generated/broken-pipe.json"],
      "tool": "node"
    },
    "files-node-results": {
      "kind": "module",
      "module": "packages/files/tools/generate-node-results.mjs",
      "inputs": ["packages/files/src/**", "packages/files/tools/**"],
      "outputs": ["packages/files/tests/generated/node-results.json"],
      "tool": "node"
    },
    "http-node-exchanges": {
      "kind": "module",
      "module": "packages/http/tools/generate-node-exchanges.mjs",
      "inputs": ["packages/http/src/**", "packages/http/tools/**"],
      "outputs": ["packages/http/tests/generated/node-exchanges.json"],
      "tool": "node"
    },
    "clock-standard-results": {
      "kind": "module",
      "module": "packages/clock/tools/generate-standard-results.mjs",
      "inputs": ["packages/clock/src/**", "packages/clock/tools/**"],
      "outputs": ["packages/clock/tests/generated/standard-results.json"],
      "tool": "node"
    }
  },
  "packages": {
    "@ai-swfactory-oss/seams": { "kind": "sdk" },
    "@ai-swfactory-oss/seams-host": { "kind": "sdk" },
    "@ai-swfactory-oss/seams-process": { "kind": "sdk" },
    "@ai-swfactory-oss/seams-logger": { "kind": "sdk" },
    "@ai-swfactory-oss/seams-module": { "kind": "sdk" },
    "@ai-swfactory-oss/seams-http-server": { "kind": "sdk" },
    "@ai-swfactory-oss/seams-tool-runner": { "kind": "sdk" },
    "@ai-swfactory-oss/seams-node-runtime": { "kind": "sdk" },
    "@ai-swfactory-oss/seams-lint-kit": { "kind": "sdk" },
    "@ai-swfactory-oss/seams-archive": { "kind": "sdk" },
    "@ai-swfactory-oss/bytes": { "kind": "sdk" },
    "@ai-swfactory-oss/clock": { "kind": "port" },
    "@ai-swfactory-oss/host": { "kind": "sdk" },
    "@ai-swfactory-oss/random": { "kind": "port" },
    "@ai-swfactory-oss/ids": { "kind": "sdk" },
    "@ai-swfactory-oss/files": { "kind": "port" },
    "@ai-swfactory-oss/http": { "kind": "port" },
    "@ai-swfactory-oss/terminal": { "kind": "port" },
    "@ai-swfactory-oss/logging": { "kind": "sdk" },
    "@ai-swfactory-oss/process": { "kind": "port" },
    "@ai-swfactory-oss/content-store": { "kind": "sdk" }
  }
}

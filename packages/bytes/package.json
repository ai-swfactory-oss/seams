{
  "name": "@ai-swfactory-oss/bytes",
  "description": "A pure base64 codec between Uint8Array and string, for the bytes ports keep in their JSON memory state.",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-swfactory-oss/seams.git",
    "directory": "packages/bytes"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"

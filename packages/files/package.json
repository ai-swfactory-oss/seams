{
  "name": "@ai-swfactory-oss/files",
  "description": "The files port: a rooted snapshot in, a list of changes out. Its memory adapter holds one Tree, and its generator records results from a real adapter.",
  "version": "3.0.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-swfactory-oss/seams.git",
    "directory": "packages/files"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./memory": {
      "source": "./src/memory/index.ts",
      "types": "./dist/memory/index.d.ts",
      "import": "./dist/memory/index.js"
    },
    "./generate": {
      "source": "./src/generate/index.ts",
      "types": "./dist/generate/index.d.ts",
      "import": "./dist/generate/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!dist/**/*.tgz"
  ],
  "dependencies": {
    "@ai-swfactory-oss/bytes": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  }
}

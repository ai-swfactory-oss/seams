{
  "name": "@ai-swfactory-oss/random",
  "description": "The random port: bytes(n) only. Its memory adapter is a seeded stream: the same seed gives the same bytes, and a generator records a memory state seeded from a real adapter.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-swfactory-oss/seams.git",
    "directory": "packages/random"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./memory": {
      "source": "./src/memory/index.ts",
      "types": "./dist/memory/index.d.ts",
      "import": "./dist/memory/index.js"
    },
    "./generate": {
      "source": "./src/generate/index.ts",
      "types": "./dist/generate/index.d.ts",
      "import": "./dist/generate/index.js"
    },
    "./standard": {
      "source": "./src/standard/index.ts",
      "types": "./dist/standard/index.d.ts",
      "import": "./dist/standard/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!dist/**/*.tgz"
  ]
}

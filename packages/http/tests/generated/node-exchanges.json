            ["sec-fetch-mode", "cors"],
            ["user-agent", "node"],
            ["accept-encoding", "gzip, deflate"]
          ],
          "body": ""
        }
      ]
    },
    {
      "name": "a redirect answered as that response",
      "state": {
        "exchanges": [
          {
            "request": {
              "method": "GET",
              "url": "http://127.0.0.1:PORT/from",
              "headers": [],
              "body": "",
              "timeLimitMs": 5000
            },
            "outcome": {
              "kind": "response",
              "status": 302,
              "headers": [
                ["connection", "close"],
                ["content-length", "0"],

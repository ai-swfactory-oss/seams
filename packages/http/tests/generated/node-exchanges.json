            ["accept", "*/*"],
            ["accept-language", "*"],
            ["sec-fetch-mode", "cors"],
            ["user-agent", "node"],
            ["accept-encoding", "gzip, deflate"]
          ],
          "body": ""
        }
      ]
    },
    {
      "name": "a request whose tls handshake fails",
      "state": {
        "exchanges": [
          {
            "request": {
              "method": "GET",
              "url": "https://127.0.0.1:PORT",
              "headers": [],
              "body": "",
              "timeLimitMs": 5000
            },
            "outcome": {
              "kind": "failure",
              "reason": "tls",
              "message": "fetch failed: 00DD2B5690750000:error:0A0000C6:SSL routines:tls_get_more_records:packet length too long:../deps/openssl/openssl/ssl/record/methods/tls_common.c:662:\n"
            }
          }
        ]
      },
      "received": []
    },
    {

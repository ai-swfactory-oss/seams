{
  "cases": [
    {
      "name": "a request sent exactly as given",
      "state": {
        "exchanges": [
          {
            "request": {
              "method": "POST",
              "url": "http://127.0.0.1:PORT/items?q=1",
              "headers": [
                ["content-type", "application/json"],
                ["x-trace", "abc"]
              ],
              "body": "eyJhIjoxfQ==",
              "timeLimitMs": 5000
            },
            "outcome": {
              "kind": "response",
              "status": 204,
              "headers": [
                ["connection", "close"],
                ["content-length", "0"]
              ],
              "body": ""
            }
          }
        ]
      },
      "received": [
        {
          "method": "POST",
          "url": "/items?q=1",
          "headers": [
            ["host", "127.0.0.1:PORT"],
            ["connection", "keep-alive"],
            ["content-type", "application/json"],
            ["x-trace", "abc"],
            ["accept", "*/*"],
            ["accept-language", "*"],
            ["sec-fetch-mode", "cors"],
            ["user-agent", "node"],
            ["accept-encoding", "gzip, deflate"],
            ["content-length", "7"]
          ],
          "body": "eyJhIjoxfQ=="
        }
      ]
    },
    {
      "name": "a response answered as received",
      "state": {
        "exchanges": [
          {
            "request": {
              "method": "GET",
              "url": "http://127.0.0.1:PORT/answer",
              "headers": [],
              "body": "",
              "timeLimitMs": 5000
            },
            "outcome": {
              "kind": "response",
              "status": 201,
              "headers": [
                ["connection", "close"],
                ["content-length", "5"],

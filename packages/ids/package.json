{
  "name": "@ai-swfactory-oss/ids",
  "description": "UUIDs built from the random port's bytes: createIdsSdk(data, { random }) returns the id operations, which take data only.",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-swfactory-oss/seams.git",
    "directory": "packages/ids"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!dist/**/*.tgz"
  ],
  "dependencies": {
    "@ai-swfactory-oss/random": "workspace:*"
  }
}

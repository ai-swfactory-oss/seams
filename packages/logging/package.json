{
  "name": "@ai-swfactory-oss/logging",
  "description": "Logging as a pure library: log records are data, formatted as a level label, a message and key=value fields, and written to stderr through the terminal port, with TTY and colour taken from host facts.",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-swfactory-oss/seams.git",
    "directory": "packages/logging"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!dist/**/*.tgz"
  ],
  "dependencies": {
    "@ai-swfactory-oss/host": "workspace:*",
    "@ai-swfactory-oss/terminal": "workspace:*"
  }
}

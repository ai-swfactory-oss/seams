{
  "name": "@ai-swfactory-oss/content-store",
  "description": "A content-addressed store of Trees over the files port: createContentStoreSdk({ root }, { files }) puts a Tree under its Tree digest and gets it back by that digest.",
  "version": "2.0.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-swfactory-oss/seams.git",
    "directory": "packages/content-store"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!dist/**/*.tgz"
  ],
  "dependencies": {
    "@ai-swfactory-oss/files": "workspace:*"
  }
}
